<?xml version="1.0" encoding="UTF-8"?>

<web-app
        xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        https://jakarta.ee/xml/ns/jakartaee
        https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
        version="6.0">


    <!-- ================= LOGIN ================= -->

    <servlet>

        <servlet-name>
            LoginServlet
        </servlet-name>

        <servlet-class>
            com.employee.LoginServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            LoginServlet
        </servlet-name>

        <url-pattern>
            /login
        </url-pattern>

    </servlet-mapping>



    <!-- ================= LOGOUT ================= -->

    <servlet>

        <servlet-name>
            LogoutServlet
        </servlet-name>

        <servlet-class>
            com.employee.LogoutServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            LogoutServlet
        </servlet-name>

        <url-pattern>
            /logout
        </url-pattern>

    </servlet-mapping>



    <!-- ================= EMPLOYEE ================= -->

    <servlet>

        <servlet-name>
            EmployeeServlet
        </servlet-name>

        <servlet-class>
            com.employee.EmployeeServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            EmployeeServlet
        </servlet-name>

        <url-pattern>
            /addEmployee
        </url-pattern>

    </servlet-mapping>



    <!-- ================= VIEW EMPLOYEES ================= -->

    <servlet>

        <servlet-name>
            ViewEmployeeServlet
        </servlet-name>

        <servlet-class>
            com.employee.ViewEmployeeServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            ViewEmployeeServlet
        </servlet-name>

        <url-pattern>
            /viewEmployees
        </url-pattern>

    </servlet-mapping>



    <!-- ================= UPDATE ================= -->

    <servlet>

        <servlet-name>
            UpdateEmployeeServlet
        </servlet-name>

        <servlet-class>
            com.employee.UpdateEmployeeServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            UpdateEmployeeServlet
        </servlet-name>

        <url-pattern>
            /updateEmployee
        </url-pattern>

    </servlet-mapping>



    <!-- ================= DELETE ================= -->

    <servlet>

        <servlet-name>
            DeleteEmployeeServlet
        </servlet-name>

        <servlet-class>
            com.employee.DeleteEmployeeServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            DeleteEmployeeServlet
        </servlet-name>

        <url-pattern>
            /deleteEmployee
        </url-pattern>

    </servlet-mapping>



    <!-- ================= DASHBOARD ================= -->

    <servlet>

        <servlet-name>
            DashboardStatsServlet
        </servlet-name>

        <servlet-class>
            com.employee.DashboardStatsServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            DashboardStatsServlet
        </servlet-name>

        <url-pattern>
            /dashboardStats
        </url-pattern>

    </servlet-mapping>



    <servlet>

        <servlet-name>
            DashboardPage
        </servlet-name>

        <servlet-class>
            org.apache.catalina.servlets.DefaultServlet
        </servlet-class>

    </servlet>


    <!-- ================= DEPARTMENTS ================= -->

    <servlet>

        <servlet-name>
            DepartmentServlet
        </servlet-name>

        <servlet-class>
            com.employee.DepartmentServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            DepartmentServlet
        </servlet-name>

        <url-pattern>
            /departments
        </url-pattern>

    </servlet-mapping>



    <!-- ================= REPORTS ================= -->

    <servlet>

        <servlet-name>
            ReportsServlet
        </servlet-name>

        <servlet-class>
            com.employee.ReportsServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            ReportsServlet
        </servlet-name>

        <url-pattern>
            /reports
        </url-pattern>

    </servlet-mapping>



    <!-- ================= AUTH FILTER ================= -->

    <filter>

        <filter-name>
            AuthFilter
        </filter-name>

        <filter-class>
            com.employee.AuthFilter
        </filter-class>

    </filter>


    <filter-mapping>

        <filter-name>
            AuthFilter
        </filter-name>

        <url-pattern>
            /*
        </url-pattern>

    </filter-mapping>



    <!-- ================= WELCOME ================= -->

    <welcome-file-list>

        <welcome-file>
            index.html
        </welcome-file>

    </welcome-file-list>
    <servlet>

        <servlet-name>
            DashboardServlet
        </servlet-name>

        <servlet-class>
            com.employee.DashboardServlet
        </servlet-class>

    </servlet>


    <servlet-mapping>

        <servlet-name>
            DashboardServlet
        </servlet-name>

        <url-pattern>
            /dashboard
        </url-pattern>

    </servlet-mapping>

</web-app>
